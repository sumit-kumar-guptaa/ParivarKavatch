# Copy to .env. Mocks are ON by default so the app runs with zero Gnani credits.
USE_MOCKS=true
USE_MOCK_STT=true
USE_MOCK_TTS=true

DATABASE_URL=sqlite:///./data/parivar_kavach.db
ALERT_LOG_PATH=./data/alerts.log

TARGET_SAMPLE_RATE=8000
PHONE_FILTER=true
MAX_AUDIO_BYTES=12000000

MAX_TURNS_EASY=4
MAX_TURNS_MEDIUM=6
MAX_TURNS_HARD=8

FAMILY_ALERT_ON_END=true
FAMILY_ALERT_SCORE_THRESHOLD=55

# --- Gnani AI live mode: fill these only after reading the official docs. ---
# Keep USE_MOCKS=true until app/stt.py, app/tts.py, and app/llm.py are wired.
GNANI_API_KEY=
EVON_ENDPOINT=
EVON_MODEL=evon-v3.3
PRISMA_ENDPOINT=https://api.vachana.ai/stt/v3
TIMBRE_ENDPOINT=https://api.vachana.ai/api/v1/tts/inference
TIMBRE_MODEL=timbre-v2.5
TIMBRE_VOICE=Poorvi
TIMBRE_LANGUAGE=hi-en
REQUEST_TIMEOUT_SECONDS=30
